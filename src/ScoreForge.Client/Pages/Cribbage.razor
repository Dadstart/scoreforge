@page "/cribbage"
@attribute [Authorize]

<PageTitle>Cribbage Score Keeper</PageTitle>

<h1>Cribbage Score Keeper</h1>
<p class="text-muted">Track pegs quickly with one-tap points and a custom score entry.</p>

<div class="cribbage-layout">
    <section class="card p-3">
        <h2 class="h5 mb-3">Scoring Controls</h2>

        <div class="custom-points-row mb-3">
            <label class="form-label mb-1" for="customPointsInput">Custom points</label>
            <InputNumber id="customPointsInput" class="form-control" @bind-Value="_customPoints" min="1" />
        </div>

        @for (var playerIndex = 0; playerIndex < _players.Length; playerIndex++)
        {
            var currentPlayerIndex = playerIndex;
            <div class="player-controls mb-3">
                <h3 class="h6 mb-2">@_players[currentPlayerIndex]</h3>
                <p class="mb-2">Score: <strong>@_scores[currentPlayerIndex]</strong> / @WinningScore</p>
                <div class="d-flex flex-wrap gap-2">
                    <button type="button" class="btn btn-primary" @onclick="() => AddPoints(currentPlayerIndex, 1)">+1</button>
                    <button type="button" class="btn btn-primary" @onclick="() => AddPoints(currentPlayerIndex, 2)">+2</button>
                    <button type="button" class="btn btn-primary" @onclick="() => AddPoints(currentPlayerIndex, 3)">+3</button>
                    <button type="button" class="btn btn-outline-primary" @onclick="() => AddPoints(currentPlayerIndex, _customPoints)">+@_customPoints</button>
                </div>
            </div>
        }

        <button type="button" class="btn btn-outline-secondary" @onclick="ResetGame">Reset game</button>
    </section>

    <section class="card p-3">
        <h2 class="h5">Board</h2>
        <div class="cribbage-board" role="img" aria-label="Wood style cribbage board with two peg lanes">
            <div class="start-finish-row">
                <span class="milestone-pill">Start</span>
                <span class="milestone-pill milestone-pill-finish">Finish 121</span>
            </div>
            <div class="board-lanes">
                @for (var playerIndex = 0; playerIndex < _players.Length; playerIndex++)
                {
                    var currentPlayerIndex = playerIndex;
                    <div class="board-lane">
                        <div class="lane-header">
                            <span class="lane-name">@_players[currentPlayerIndex]</span>
                            <span class="lane-score">@_scores[currentPlayerIndex]</span>
                        </div>

                        @for (var segmentIndex = 0; segmentIndex < SegmentCount; segmentIndex++)
                        {
                            var segment = GetSegmentHoles(segmentIndex);
                            <div class="hole-row">
                                @foreach (var hole in segment)
                                {
                                    var cssClass = GetHoleCssClass(currentPlayerIndex, hole);
                                    <button type="button"
                                            class="@cssClass"
                                            title="@GetHoleTitle(currentPlayerIndex, hole)"
                                            aria-label="@GetHoleTitle(currentPlayerIndex, hole)"
                                            @onclick="() => MovePegTo(currentPlayerIndex, hole)">
                                    </button>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
            <div class="milestone-row">
                @for (var hole = SegmentSize; hole < WinningScore; hole += SegmentSize)
                {
                    <span class="milestone-chip">@hole</span>
                }
            </div>
        </div>
        <p class="text-muted mb-0 mt-2">Solid peg = current score, ring peg = previous score. Click a hole to correct score quickly.</p>
    </section>

    <section class="card p-3">
        <div class="d-flex justify-content-between align-items-center gap-2 mb-2">
            <h2 class="h5 mb-0">Recent Entries</h2>
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="UndoLastEntry" disabled="@(_entries.Count == 0)">Undo last</button>
        </div>
        @if (_entries.Count == 0)
        {
            <p class="text-muted mb-0">No scores yet. Add points to begin.</p>
        }
        else
        {
            <ul class="list-group list-group-flush">
                @foreach (var entry in _entries)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                        <span>@entry.PlayerName +@entry.Points</span>
                        <small class="text-muted">@entry.RecordedAt.LocalDateTime.ToString("t")</small>
                    </li>
                }
            </ul>
        }
    </section>
</div>

@code {
    private const int WinningScore = 121;
    private const int MaxEntriesToKeep = 25;
    private const int SegmentSize = 30;
    private const int SegmentCount = 5;

    private readonly string[] _players = ["Player 1", "Player 2"];
    private readonly int[] _scores = [0, 0];
    private readonly int?[] _previousScores = [null, null];
    private readonly List<ScoreEntry> _entries = [];
    private int _customPoints = 4;

    private void AddPoints(int playerIndex, int points)
    {
        if (playerIndex < 0 || playerIndex >= _players.Length || points <= 0)
            return;

        var previousPreviousScore = _previousScores[playerIndex];
        var previousScore = _scores[playerIndex];
        var updatedScore = Math.Min(WinningScore, previousScore + points);

        _previousScores[playerIndex] = previousScore;
        _scores[playerIndex] = updatedScore;

        AddEntry(playerIndex, points, previousScore, previousPreviousScore);
    }

    private IEnumerable<int> GetSegmentHoles(int segmentIndex)
    {
        var start = segmentIndex * SegmentSize;
        var end = Math.Min(WinningScore, start + SegmentSize);
        var holes = Enumerable.Range(start, (end - start) + 1);
        return segmentIndex % 2 == 0 ? holes : holes.Reverse();
    }

    private void MovePegTo(int playerIndex, int hole)
    {
        if (playerIndex < 0 || playerIndex >= _players.Length)
            return;

        if (hole < 0 || hole > WinningScore || hole == _scores[playerIndex])
            return;

        var previousPreviousScore = _previousScores[playerIndex];
        var previousScore = _scores[playerIndex];
        _previousScores[playerIndex] = previousScore;
        _scores[playerIndex] = hole;

        var delta = hole - previousScore;
        if (delta > 0)
            AddEntry(playerIndex, delta, previousScore, previousPreviousScore);
    }

    private void UndoLastEntry()
    {
        if (_entries.Count == 0)
            return;

        var entry = _entries[0];
        _entries.RemoveAt(0);

        _scores[entry.PlayerIndex] = entry.PreviousScore;
        _previousScores[entry.PlayerIndex] = entry.PreviousPreviousScore;
    }

    private void AddEntry(int playerIndex, int points, int previousScore, int? previousPreviousScore)
    {
        _entries.Insert(0, new ScoreEntry(playerIndex, _players[playerIndex], points, previousScore, previousPreviousScore, DateTimeOffset.Now));
        if (_entries.Count > MaxEntriesToKeep)
            _entries.RemoveAt(_entries.Count - 1);
    }

    private string GetHoleCssClass(int playerIndex, int hole)
    {
        var cssClass = "board-hole";
        cssClass += playerIndex == 0 ? " board-hole-p1" : " board-hole-p2";

        if (hole == _scores[playerIndex])
            cssClass += " board-hole-current";

        if (_previousScores[playerIndex] is int previousHole && hole == previousHole)
            cssClass += " board-hole-previous";

        if (hole is 0 or WinningScore)
            cssClass += " board-hole-marker";

        if (hole is 90 or 120)
            cssClass += " board-hole-skunk";

        return cssClass;
    }

    private string GetHoleTitle(int playerIndex, int hole)
    {
        if (hole == _scores[playerIndex])
            return $"{_players[playerIndex]} current peg: {hole}";

        if (_previousScores[playerIndex] is int previousHole && hole == previousHole)
            return $"{_players[playerIndex]} previous peg: {hole}";

        return $"{_players[playerIndex]} hole {hole}";
    }

    private void ResetGame()
    {
        for (var index = 0; index < _scores.Length; index++)
        {
            _scores[index] = 0;
            _previousScores[index] = null;
        }

        _entries.Clear();
        _customPoints = 4;
    }

    private sealed record ScoreEntry(
        int PlayerIndex,
        string PlayerName,
        int Points,
        int PreviousScore,
        int? PreviousPreviousScore,
        DateTimeOffset RecordedAt);
}
