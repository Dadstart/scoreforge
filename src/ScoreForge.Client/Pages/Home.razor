@page "/"
@inject ILocalStore LocalStore

<PageTitle>ScoreForge</PageTitle>

<h1>ScoreForge Foundation</h1>

<p>Phase 1 is scaffolded with shared contracts, API skeleton, and local state abstraction.</p>

<div class="card p-3 mt-3">
    <h2 class="h5">Sample Scoreboard</h2>
    @if (scoreboard is null)
    {
        <p class="text-muted mb-0">Loading local seed data...</p>
    }
    else
    {
        <p class="mb-1"><strong>@scoreboard.Name</strong> (v@scoreboard.Version)</p>
        <p class="mb-0 text-muted">Participants: @scoreboard.Participants.Count, Events: @scoreboard.Events.Count</p>
    }
</div>

@code {
    private const string SeedKey = "foundation.seed.scoreboard";
    private Scoreboard? scoreboard;

    protected override async Task OnInitializedAsync()
    {
        scoreboard = await LocalStore.GetItemAsync<Scoreboard>(SeedKey);
        if (scoreboard is not null)
            return;

        var participant = new ScoreboardParticipant(
            Guid.NewGuid(),
            "Player 1",
            0,
            DateTimeOffset.UtcNow);

        scoreboard = new Scoreboard(
            Guid.NewGuid(),
            Guid.NewGuid(),
            Guid.NewGuid(),
            "Starter Match",
            0,
            DateTimeOffset.UtcNow,
            DateTimeOffset.UtcNow,
            [participant],
            []);

        await LocalStore.SetItemAsync(SeedKey, scoreboard);
    }
}
